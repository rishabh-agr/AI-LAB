import heapq

# Heuristic function: Manhattan distance
def manhattan_distance(state):
    distance = 0
    for i, value in enumerate(state):
        if value != 0:
            target_x, target_y = divmod(value - 1, 3)
            current_x, current_y = divmod(i, 3)
            distance += abs(target_x - current_x) + abs(target_y - current_y)
    return distance

def a_star(start_state):
    goal_state = (1, 2, 3, 4, 5, 6, 7, 8, 0)
    
    def get_neighbors(state):
        neighbors = []
        zero_pos = state.index(0)
        moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # up, down, left, right
        row, col = divmod(zero_pos, 3)
        for r, c in moves:
            new_row, new_col = row + r, col + c
            if 0 <= new_row < 3 and 0 <= new_col < 3:
                new_pos = new_row * 3 + new_col
                new_state = list(state)
                new_state[zero_pos], new_state[new_pos] = new_state[new_pos], new_state[zero_pos]
                neighbors.append(tuple(new_state))
        return neighbors
    
    open_set = []
    heapq.heappush(open_set, (manhattan_distance(start_state), 0, start_state, []))
    visited = set()
    visited.add(start_state)
    
    while open_set:
        _, cost, state, path = heapq.heappop(open_set)
        if state == goal_state:
            return path
        
        for neighbor in get_neighbors(state):
            if neighbor not in visited:
                visited.add(neighbor)
                heapq.heappush(open_set, (cost + 1 + manhattan_distance(neighbor), cost + 1, neighbor, path + [neighbor]))
    return None

start = (1, 2, 3, 4, 0, 6, 7, 5, 8)
solution = a_star(start)
print("Solution path:", solution)
